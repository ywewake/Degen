# Copy to config/.env. config/.env is gitignored.
# Interactive Brokers PAPER account via TWS or IB Gateway. No API keys:
# IBKR authenticates through the logged-in TWS/Gateway session.
IBKR_HOST=127.0.0.1
# Paper ports: 7497 (TWS) or 4002 (Gateway). Live ports 7496/4001 are refused.
IBKR_PORT=7497
IBKR_CLIENT_ID=1
# Paper account IDs start with DU. Anything else is refused.
IBKR_ACCOUNT=
#
# The sealed-data key never goes here, or anywhere on disk.
